# ──────────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string. Required.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name. Optional, defaults to "zicha-study".
MONGODB_DB=zicha-study

# ──────────────────────────────────────────────────────────────────────────────
# Authentication (Auth.js / NextAuth v5 + Microsoft Entra ID)
# App registration steps: docs/ONEDRIVE_OAUTH_SETUP.md
# ──────────────────────────────────────────────────────────────────────────────

# Signs and encrypts the session cookie. Required.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Client ID and client secret of the Entra app registration. Required.
# The app must accept personal Microsoft accounts only. It needs the delegated
# Graph scopes User.Read, Files.Read.All, Files.ReadWrite.All and offline_access.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Comma-separated email addresses allowed to sign in.
# If empty, any personal Microsoft account can sign in and edit all data.
# Set it in every deployment other people can reach.
ALLOWED_EMAILS=

# Auth.js redirect proxy that lets Vercel preview deployments sign in.
# Leave it unset locally. On Vercel, set it on both Production and Preview to
#   AUTH_REDIRECT_PROXY_URL=https://www.zicha.study/api/auth
# and use the same AUTH_SECRET in both. Use the www origin: the apex redirects to
# www, and the redirect breaks the proxy. See docs/VERCEL_DEPLOYMENT.md.
AUTH_REDIRECT_PROXY_URL=

# ──────────────────────────────────────────────────────────────────────────────
# Public share URLs (optional)
# NEXT_PUBLIC_* values are compiled in at build time. See README.md.
# ──────────────────────────────────────────────────────────────────────────────

# "true" shows share links with the study slug as a subdomain
# (https://newton.zicha.study/mat). Leave it unset locally. Links then use the
# current origin (http://localhost:3000/newton/mat).
NEXT_PUBLIC_USE_SUBDOMAIN_SHARE_URLS=

# Domain for subdomain share links, e.g. "zicha.study".
NEXT_PUBLIC_SHARE_BASE_DOMAIN=

# ──────────────────────────────────────────────────────────────────────────────
# Build metadata (optional)
# next.config.mjs detects these from git or the CI provider. Set them only to
# override the detected values.
# ──────────────────────────────────────────────────────────────────────────────

# Commit SHA shown in the footer and returned by /api/version. Falls back to
# GITHUB_SHA, VERCEL_GIT_COMMIT_SHA, COMMIT_SHA, CF_PAGES_COMMIT_SHA,
# RENDER_GIT_COMMIT, then `git rev-parse HEAD`, then "development".
NEXT_PUBLIC_COMMIT_SHA=

# Build timestamp (ISO 8601). Falls back to BUILD_TIME, then the time of the build.
NEXT_PUBLIC_BUILD_TIME=
